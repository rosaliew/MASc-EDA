# ---------------------------------------------------------------------------
# MASc-EDA .gitignore
#
# Policy: raw instrument data, genome files and pipeline dumps stay on disk but
# out of git. GitHub hard-rejects any single file over 100 MB.
#
# Rules are keyed to FILE TYPE and to DIRECTORY NAME at any depth -- never to a
# specific dataset path or GUID. A new download folder or a renamed directory is
# then covered automatically, with no edit here. Do not re-anchor these to
# specific paths.
# ---------------------------------------------------------------------------

# --- Raw mass-spec data -----------------------------------------------------
*.mzML
*.mzXML
*.mzData
*.mgf
*.raw
*.wiff
*.wiff.scan
*.baf
*.tdf
*.tdf_bin

# --- Genome / sequence data -------------------------------------------------
*.gbk
*.gbff
*.genbank
*.embl
*.fasta
*.fa
*.fna
*.faa
*.sto
*.hmm

# --- Pipeline output directories (any depth) --------------------------------
antismash_results/
bigscape_running_output/
nf_output/
librarysummary/

# --- Archives & databases ---------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.7z
*.db
*.sqlite
*.sqlite3
*.h5
*.hdf5
*.pickle
*.pkl
*.npy
*.npz

# --- Python / env -----------------------------------------------------------
__pycache__/
*.py[cod]
.env
.venv
env/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- OS / editor ------------------------------------------------------------
.DS_Store
.idea/
*:Zone.Identifier
*Zone.Identifier*
