# ---------------------------------------------------------------------------
# MASc-EDA .gitignore
#
# Policy: raw instrument data, genome files and pipeline dumps stay on disk but
# out of git. GitHub hard-rejects any single file over 100 MB.
#
# Rules are keyed to FILE TYPE and to DIRECTORY NAME at any depth -- never to a
# specific dataset path or GUID. A new download folder or a renamed directory is
# then covered automatically, with no edit here. Do not re-anchor these to
# specific paths.
# ---------------------------------------------------------------------------

# --- Raw mass-spec data -----------------------------------------------------
*.mzML
*.mzXML
*.mzData
*.mgf
*.raw
*.wiff
*.wiff.scan
*.baf
*.tdf
*.tdf_bin

# --- Genome / sequence data -------------------------------------------------
*.gbk
*.gbff
*.genbank
*.embl
*.fasta
*.fa
*.fna
*.faa
*.sto
*.hmm

# --- Pipeline output directories (any depth) --------------------------------
antismash_results/
bigscape_running_output/
nf_output/
librarysummary/

# --- Archives & databases ---------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.bz2
*.7z
*.db
*.sqlite
*.sqlite3
*.h5
*.hdf5
*.pickle
*.pkl
*.npy
*.npz

# --- Python / env -----------------------------------------------------------
__pycache__/
*.py[cod]
.env
.venv
env/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- OS / editor ------------------------------------------------------------
.DS_Store
.idea/
*:Zone.Identifier
*Zone.Identifier*

# GNPS task result files cached by scripts/build_ground_truth.py --resolve-gnps
data/PoDP/gnps_cache/

# MIBiG release bundle, re-downloaded on demand by build_ground_truth.py
data/MiBIG_4.0/

# Staged genome re-downloads (large; reproducible from refetch_plan.csv)
data/PoDP/genome_refetch/*.gbk

# --- Pipeline output: regenerable, keyed to directory name at any depth -----
# antiSMASH, BiG-SCAPE and GNPS job results are outputs of a recorded input +
# a recorded tool version. Tracking them costs hundreds of MB and gains nothing
# the scripts cannot rebuild. GitHub also hard-rejects any single file >100 MB,
# and gnps_function/ contains one at 102 MB.
*_antiSMASH/
antismash/
bigscape_results/
gnps_function/
MCE_GNPS/
MCE_GNPS_indiv/

# Published supplements: re-downloadable from the paper, not our data.
# The .xlsx IS kept -- the NPOmix validation table is joined against in code.
data/NPOmix_inputs/*.pdf

# --- Local tool / editor state ----------------------------------------------
# Machine-specific: absolute interpreter paths and per-machine permissions.
.claude/settings.local.json

# --- Archived / retired artifacts -------------------------------------------
# Superseded CSVs, notebooks and scripts are moved aside rather than deleted so
# a number in an old draft can still be traced. They are deliberately NOT
# tracked: they encode definitions we have since replaced, and keeping them in
# git invites someone re-deriving a stale count from them. Keyed to directory
# name at any depth so it catches archive/ nested under results/, notebooks/ etc.
archive/
.archive/
_archived/

# --- Large regenerable data ---------------------------------------------------
# Downloaded/derived genome and MS2 sample files, dominated by files >50MB.
# Re-downloadable from data/raw + the accessions recorded in results/podp/.
data/processed/
